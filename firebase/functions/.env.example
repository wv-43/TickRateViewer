# Copie ce fichier en .env (dans firebase/functions/) avant « firebase deploy »
# Adresses autorisées pour le retour de la connexion Steam (séparées par des virgules)
SITE_URLS=https://tickratecsgo.web.app,http://localhost:5500
# Facultatif : URL publique de la fonction steamAuth si elle est différente de l'URL par défaut
STEAM_FN_URL=
# Où les demos GOTV sont stockées (pour les examinateurs Vigie)
DEMO_BASE_URL=
# Votes nécessaires pour un verdict Vigie
VIGIE_VOTES=6
# Clé web publique Firebase (même valeur que FB_API_KEY du site) : connexion par pseudo
WEB_API_KEY=
