# Liste blanche : tout est ignoré sauf ce qui est explicitement autorisé ici.
# Un nouveau fichier n'est donc jamais publié par accident.
/*
!/.gitignore
!/README.md

# Site, règles de la base et fonctions serveur
!/firebase/
/firebase/*
!/firebase/LISEZ-MOI.md
!/firebase/firebase.json
!/firebase/database.rules.json
!/firebase/public/
!/firebase/functions/
/firebase/functions/*
!/firebase/functions/index.js
!/firebase/functions/package.json
!/firebase/functions/package-lock.json
!/firebase/functions/.env.example
!/firebase/functions/data/
!/firebase/functions/lib/
!/firebase/functions/test/
!/firebase/tools/
/firebase/tools/*
!/firebase/tools/build-mono.js
!/firebase/tools/build-seo.js
!/firebase/tools/footer.js
!/firebase/tools/indexnow.js
!/firebase/tools/seo/
/firebase/tools/seo/liens-externes.md
/firebase/tools/seo/indexnow-state.json

# Serveurs de jeu : sources, réglages et scripts d'installation
!/server-cs/
/server-cs/*
!/server-cs/LISEZ-MOI.md
!/server-cs/cfg/
!/server-cs/install/
!/server-cs/ping-responder/
!/server-cs/addons/
/server-cs/addons/*
!/server-cs/addons/sourcemod/
/server-cs/addons/sourcemod/*
!/server-cs/addons/sourcemod/gamedata/
!/server-cs/addons/sourcemod/translations/
!/server-cs/addons/sourcemod/scripting/

# Anti-triche : les seuils de détection aideraient les tricheurs à passer dessous
/firebase/functions/lib/vigie.js
/server-cs/addons/sourcemod/scripting/tickrate_vigie.sp
/firebase/functions/test/run.js

# Jamais publiés, où qu'ils soient
node_modules/
.env
*.pem
*.log
*.smx
*.bsp
*.bz2
